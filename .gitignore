# =====================================================================
# ScreenTune - Git 忽略规则
# =====================================================================

# Rust 构建产物
/target
**/*.rs.bk

# 运行时数据（日志、配置备份等，均位于系统目录，不应入库）
logs/

# 本地运行生成的图标等生成物（由 scripts/gen_icon.py 重新生成）
assets/*.png
assets/*.ico

# 编辑器 / 系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 临时文件
*.tmp
*.log
