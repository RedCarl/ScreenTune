# =====================================================================
# ScreenTune - Git 忽略规则
# =====================================================================

# Rust 构建产物
/target
**/*.rs.bk

# 运行时数据（日志、配置备份等，均位于系统目录，不应入库）
logs/

# 图标由 scripts/gen_icon.py 生成；正式资源入库以便 Windows CI 直接构建
# 若仅本地试验，可用 git update-index --skip-worktree assets/icon.*

# 编辑器 / 系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 临时文件
*.tmp
*.log
